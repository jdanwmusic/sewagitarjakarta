---
import { waFinal } from "../data/site";
---

<section class="final-cta">
  <div class="container final-cta__box">
    <h2>Butuh Gitar untuk Disewa?</h2>
    <p>Hubungi via WhatsApp untuk cek ketersediaan gitar pilihan Anda hari ini.</p>
    <a class="btn btn-whatsapp final-cta__btn" href={waFinal} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
        <path d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.24.6 4.34 1.65 6.15L4 29l8.02-1.61a12.9 12.9 0 0 0 4 .64c6.62 0 12.02-5.4 12.02-12.03C28.04 8.4 22.64 3 16.02 3Zm5.44 13.47c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.06 4.48.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"/>
      </svg>
      Sewa via WhatsApp
    </a>
  </div>
</section>

<style>
  .final-cta {
    padding-block: var(--space-section);
  }

  .final-cta__box {
    background: var(--color-rosewood);
    background-image: radial-gradient(circle at 15% 20%, rgba(255, 255, 255, 0.06), transparent 55%);
    border-radius: var(--radius-lg);
    padding: clamp(2.75rem, 6vw, 4.5rem) clamp(1.5rem, 6vw, 3rem);
    text-align: center;
    color: #fff8f2;
  }

  .final-cta__box h2 {
    color: #fff8f2;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
  }

  .final-cta__box p {
    margin-top: 0.9rem;
    font-size: 1.08rem;
    color: rgba(255, 248, 242, 0.82);
  }

  .final-cta__btn {
    margin-top: 2rem;
    padding: 1rem 2.1rem;
    font-size: 1.02rem;
  }
</style>

---
import { siteConfig } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer" id="kontak">
  <div class="container footer-grid">
    <div class="footer-col footer-col--brand">
      <p class="footer-brand">SEWA GITAR JAKARTA</p>
      <p class="text-muted">
        Solusi penyewaan gitar elektrik, akustik, dan bass untuk area Jakarta
        dan Tangerang.
      </p>
    </div>

    <div class="footer-col">
      <h3>Navigasi</h3>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/gitar">Katalog Gitar</a></li>
        <li><a href="/cara-sewa">Cara Sewa</a></li>
        <li><a href="/faq">FAQ</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Kategori</h3>
      <ul>
        <li><a href="/gitar?kategori=Elektrik">Gitar Elektrik</a></li>
        <li><a href="/gitar?kategori=Akustik">Gitar Akustik</a></li>
        <li><a href="/gitar?kategori=Bass">Gitar Bass</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Kontak</h3>
      <ul>
        <li><a href={`tel:+${siteConfig.phoneDisplay.replace(/-/g, "")}`}>{siteConfig.phoneDisplay}</a></li>
        <li><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></li>
        <li>
          <a href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer">
            {siteConfig.address.full}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>
      &copy; {year} SEWA GITAR JAKARTA. Sewa Gitar Elektrik, Akustik &amp; Bass
      Jakarta &amp; Tangerang.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: #efe9dd;
    padding-block: clamp(3rem, 6vw, 4.5rem) 1.75rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(239, 233, 221, 0.14);
  }

  .footer-col--brand .text-muted {
    color: rgba(239, 233, 221, 0.65);
    max-width: 32ch;
    margin-top: 0.9rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: #fff8f2;
  }

  .footer-brand span {
    color: var(--color-brass-light);
  }

  .footer-col h3 {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(239, 233, 221, 0.55);
    margin-bottom: 1rem;
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer-col a {
    color: rgba(239, 233, 221, 0.88);
    font-size: 0.95rem;
    transition: color 0.15s ease;
  }

  .footer-col a:hover {
    color: var(--color-brass-light);
  }

  .footer-bottom {
    padding-top: 1.75rem;
  }

  .footer-bottom p {
    font-size: 0.85rem;
    color: rgba(239, 233, 221, 0.55);
  }

  @media (max-width: 880px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

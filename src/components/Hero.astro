---
import { waLink } from "../data/guitars";
import GuitarImage from "./GuitarImage.astro";

const waHero = waLink("Halo SEWAGITAR.COM, saya ingin menyewa gitar.");
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Layanan Cepat · Jakarta &amp; Tangerang</p>
      <h1>Sewa Gitar yang Siap Pakai.</h1>
      <p class="hero__sub">
        Gitar elektrik, akustik, dan bass untuk rekaman, latihan, atau
        panggung. Siap pakai, terawat, dan langsung kirim.
      </p>

      <div class="hero__badges">
        <span class="tag">Elektrik &bull; Akustik &bull; Bass</span>
        <span class="tag">Siap Pakai &bull; Terawat &bull; Siap Kirim</span>
      </div>

      <div class="hero__actions">
        <a class="btn btn-primary" href="/gitar">Lihat Katalog Gitar</a>
        <a class="btn btn-whatsapp" href={waHero} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.24.6 4.34 1.65 6.15L4 29l8.02-1.61a12.9 12.9 0 0 0 4 .64c6.62 0 12.02-5.4 12.02-12.03C28.04 8.4 22.64 3 16.02 3Zm5.44 13.47c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.06 4.48.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"/>
          </svg>
          Sewa via WhatsApp
        </a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__visual-shape" aria-hidden="true"></div>
      <div class="hero__visual-frame">
        <GuitarImage
          src="parker-pm10.jpg"
          alt="Gitar elektrik Parker PM10 siap disewa di SEWAGITAR.COM"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero__price-float">
        <span class="hero__price-label">Mulai dari</span>
        <span class="hero__price-value">Rp 100.000<span>/24 jam</span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 6vw, 5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__copy h1 {
    font-size: clamp(2.6rem, 5.4vw, 4rem);
    margin-top: 0.9rem;
    max-width: 14ch;
  }

  .hero__sub {
    margin-top: 1.4rem;
    max-width: 46ch;
    font-size: 1.1rem;
    color: var(--color-ink-soft);
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.2rem;
  }

  .hero__visual {
    position: relative;
    aspect-ratio: 4 / 5;
  }

  .hero__visual-shape {
    position: absolute;
    inset: 4% 8%;
    background: linear-gradient(155deg, var(--color-rosewood), var(--color-rosewood-dark));
    border-radius: var(--radius-lg);
    transform: rotate(-3deg);
  }

  .hero__visual-frame {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-card);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-line);
  }

  .hero__price-float {
    position: absolute;
    left: -8px;
    bottom: 10%;
    background: var(--color-card);
    border-radius: var(--radius-md);
    padding: 0.9rem 1.2rem;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero__price-label {
    font-size: 0.78rem;
    color: var(--color-ink-soft);
    font-weight: 600;
  }

  .hero__price-value {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-rosewood);
  }

  .hero__price-value span {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    margin-left: 0.2rem;
  }

  @media (max-width: 940px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      aspect-ratio: 4 / 3.4;
      order: -1;
    }
    .hero__copy h1 {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .hero__price-float {
      left: 6px;
      padding: 0.7rem 0.9rem;
    }
    .hero__price-value {
      font-size: 1.1rem;
    }
  }
</style>

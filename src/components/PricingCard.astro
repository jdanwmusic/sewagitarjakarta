---
import type { PricingPlan } from "../data/site";

interface Props {
  plan: PricingPlan;
  featured?: boolean;
}

const { plan, featured = false } = Astro.props;
---

<div class:list={["pricing-card", { "pricing-card--featured": featured }]}>
  {plan.badge && <span class="pricing-card__badge">{plan.badge}</span>}

  <p class="pricing-card__label">{plan.label}</p>
  <p class="pricing-card__duration">{plan.duration}</p>
  <p class="pricing-card__price">{plan.price}</p>

  <ul class="pricing-card__features">
    {plan.features.map((feature) => (
      <li>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 10.5l3.6 3.6L16 5.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {feature}
      </li>
    ))}
  </ul>

  <a
    class:list={["btn", featured ? "btn-primary" : "btn-outline", "btn-block"]}
    href={plan.waUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    {plan.ctaLabel}
  </a>
</div>

<style>
  .pricing-card {
    position: relative;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 2.1rem 1.9rem 2rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pricing-card--featured {
    border-color: var(--color-rosewood);
    box-shadow: var(--shadow-md);
  }

  .pricing-card__badge {
    position: absolute;
    top: -13px;
    right: 1.6rem;
    background: var(--color-rosewood);
    color: #fff8f2;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.32rem 0.8rem;
    border-radius: 999px;
  }

  .pricing-card__label {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
  }

  .pricing-card__duration {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
  }

  .pricing-card__price {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 600;
    color: var(--color-rosewood);
  }

  .pricing-card__features {
    margin-top: 1.6rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1;
  }

  .pricing-card__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
  }

  .pricing-card__features svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--color-brass);
    margin-top: 0.1rem;
  }
</style>

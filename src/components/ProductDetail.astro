---
import type { Guitar } from "../data/guitars";
import { waLinkForGuitar } from "../data/guitars";
import { siteConfig } from "../data/site";
import GuitarImage from "./GuitarImage.astro";
import Breadcrumb from "./Breadcrumb.astro";
import ProductGrid from "./ProductGrid.astro";
import { guitars } from "../data/guitars";

interface Props {
  guitar: Guitar;
}

const { guitar } = Astro.props;
const waLink = waLinkForGuitar(guitar);

const related = guitars
  .filter((g) => g.category === guitar.category && g.slug !== guitar.slug)
  .slice(0, 3);
---

<div class="product-detail">
  <div class="container">
    <Breadcrumb
      items={[
        { label: "Home", href: "/" },
        { label: "Katalog", href: "/gitar" },
        { label: guitar.name },
      ]}
    />

    <div class="product-detail__grid">
      <div class="product-detail__media">
        <GuitarImage
          src={guitar.image}
          alt={`Foto ${guitar.name} — sewa gitar ${guitar.category.toLowerCase()} SEWAGITAR.COM area Jakarta dan Tangerang`}
          loading="eager"
          fetchpriority="high"
        />
        {!guitar.available && <span class="product-detail__unavailable">Tidak Tersedia</span>}
      </div>

      <div class="product-detail__info">
        <span class="tag">{guitar.category}</span>
        <h1>{guitar.name}</h1>

        <div class="product-detail__price-row">
          <p class="product-detail__price">
            {guitar.price}<span>/24 jam</span>
          </p>
          <span class:list={["status-dot", { "is-unavailable": !guitar.available }]}>
            {guitar.available ? "Tersedia" : "Tanyakan Ketersediaan"}
          </span>
        </div>

        <p class="product-detail__desc">{guitar.description}</p>
        {guitar.note && <p class="product-detail__note">{guitar.note}</p>}

        <a class="btn btn-whatsapp btn-block product-detail__cta" href={waLink} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
            <path d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.24.6 4.34 1.65 6.15L4 29l8.02-1.61a12.9 12.9 0 0 0 4 .64c6.62 0 12.02-5.4 12.02-12.03C28.04 8.4 22.64 3 16.02 3Zm5.44 13.47c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.06 4.48.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"/>
          </svg>
          Cek Ketersediaan via WhatsApp
        </a>

        <dl class="product-detail__meta">
          <div>
            <dt>Cocok untuk</dt>
            <dd>{guitar.suitableFor.join(", ")}</dd>
          </div>
          <div>
            <dt>Jenis instrumen</dt>
            <dd>{guitar.category}</dd>
          </div>
          <div>
            <dt>Harga sewa</dt>
            <dd>{guitar.price} / 24 jam</dd>
          </div>
          <div>
            <dt>Area layanan</dt>
            <dd>{siteConfig.serviceArea}</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>{guitar.available ? "Tersedia" : "Tanyakan ketersediaan via WhatsApp"}</dd>
          </div>
        </dl>
      </div>
    </div>

    {related.length > 0 && (
      <section class="product-detail__related">
        <div class="section-head">
          <p class="eyebrow">Kategori Serupa</p>
          <h2>Gitar {guitar.category} Lainnya</h2>
        </div>
        <ProductGrid guitars={related} />
      </section>
    )}
  </div>
</div>

<style>
  .product-detail__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .product-detail__media {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-md);
  }

  .product-detail__unavailable {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--color-ink);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
  }

  .product-detail__info h1 {
    margin-top: 0.7rem;
    font-size: clamp(2rem, 3.6vw, 2.6rem);
  }

  .product-detail__price-row {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1.1rem;
  }

  .product-detail__price {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.9rem;
    color: var(--color-rosewood);
  }

  .product-detail__price span {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .product-detail__desc {
    margin-top: 1.3rem;
    font-size: 1.05rem;
    color: var(--color-ink-soft);
    max-width: 52ch;
  }

  .product-detail__note {
    margin-top: 0.7rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-brass);
  }

  .product-detail__cta {
    margin-top: 1.75rem;
    padding: 1rem 1.5rem;
    font-size: 1rem;
  }

  .product-detail__meta {
    margin-top: 2.1rem;
    display: grid;
    gap: 0.9rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }

  .product-detail__meta div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.95rem;
  }

  .product-detail__meta dt {
    color: var(--color-ink-soft);
    font-weight: 500;
  }

  .product-detail__meta dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }

  .product-detail__related {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-line);
  }

  @media (max-width: 860px) {
    .product-detail__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

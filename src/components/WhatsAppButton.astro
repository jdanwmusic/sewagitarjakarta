---
import { waGeneral } from "../data/site";
---

<a
  href={waGeneral}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float"
  aria-label="Hubungi SEWA GITAR JAKARTA via WhatsApp"
>
  <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
    <path d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.24.6 4.34 1.65 6.15L4 29l8.02-1.61a12.9 12.9 0 0 0 4 .64c6.62 0 12.02-5.4 12.02-12.03C28.04 8.4 22.64 3 16.02 3Zm0 21.9c-1.94 0-3.75-.53-5.3-1.46l-.38-.22-4.76.95.96-4.63-.25-.4a9.86 9.86 0 0 1-1.53-5.12c0-5.47 4.45-9.92 9.92-9.92 5.47 0 9.92 4.45 9.92 9.92 0 5.47-4.45 9.92-9.92 9.92Zm5.44-7.43c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.06 4.48.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35Z"/>
  </svg>
  <span class="visually-hidden">Chat WhatsApp</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 150;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--color-whatsapp);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 28px -8px rgba(23, 130, 68, 0.55);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .wa-float:hover {
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 14px 34px -8px rgba(23, 130, 68, 0.6);
  }

  .wa-float svg {
    width: 30px;
    height: 30px;
  }

  @media (max-width: 560px) {
    .wa-float {
      width: 52px;
      height: 52px;
      right: 1rem;
      bottom: 1rem;
    }
    .wa-float svg {
      width: 26px;
      height: 26px;
    }
  }
</style>
